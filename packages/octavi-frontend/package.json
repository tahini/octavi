{
  "engines": {
    "node": ">=24.0.0"
  },
  "name": "octavi-frontend",
  "version": "0.5.0",
  "description": "Octavi dashboard frontend",
  "repository": "github.com/chairemobilite/octavi",
  "license": "MIT",
  "scripts": {
    "build:dev": "cross-env NODE_OPTIONS=\"--trace-deprecation --max_old_space_size=4096 --openssl-legacy-provider\" webpack watch --progress --color --mode development --node-env development",
    "build:prod": "cross-env NODE_OPTIONS=\"--trace-deprecation --max_old_space_size=4096 --openssl-legacy-provider\" webpack --progress --color --mode production --node-env production",
    "build:test": "cross-env NODE_OPTIONS=\"--openssl-legacy-provider\" webpack watch --mode development --progress --color --node-env test",
    "compile": "tsc && yarn copy-files",
    "compile:dev": "tsc -w",
    "clean": "rimraf lib/",
    "copy-files": "copyfiles -u 1 src/styles/*.scss lib/ && copyfiles -u 1 -e ./assets/icons/sources/* -e ./assets/icons/**/sources/* -e ./assets/icons/**/**/sources/* ./assets/icons/**/* ./assets/icons/**/**/* ./lib/assets/",
    "test": "echo 'cross-env NODE_ENV=test jest --config=jest.config.js'",
    "test:unit": "cross-env NODE_ENV=test jest --config=jest.config.js",
    "test:sequential": "echo 'cross-env NODE_ENV=test jest --config=jest.sequential.config.js --runInBand'",
    "test:ui": "LOCALE_DIR=$(pwd)/locales npx playwright test",
    "lint": "eslint .",
    "format": "prettier-eslint \"./src/**/*.{ts,tsx}\" --write"
  },
  "dependencies": {
    "chaire-lib-common": "^0.2.2",
    "chaire-lib-frontend": "^0.2.2",
    "i18next": "^26.0.6",
    "lodash": "^4.18.1",
    "octavi-common": "^0.5.0",
    "octavi-legacy": "^0.5.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.18.2",
    "redux": "^5.0.1",
    "socket.io-client": "^4.8.1",
    "transition-frontend": "^0.2.0-2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.21",
    "@types/node": "^24.10.4",
    "@types/react-dom": "^19.2.3",
    "@types/react-mathjax": "^1.0.4",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "chaire-lib-backend": "^0.2.2",
    "clean-webpack-plugin": "^4.0.0",
    "compression-webpack-plugin": "^11.1.0",
    "copy-webpack-plugin": "^13.0.1",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-react": "^7.37.2",
    "html-webpack-plugin": "^5.6.5",
    "jest": "^30.2.0",
    "json-loader": "^0.5.7",
    "mini-css-extract-plugin": "^2.9.4",
    "prettier-eslint-cli": "^8.0.1",
    "rimraf": "^6.1.2",
    "sass": "^1.94.2",
    "sass-loader": "^16.0.6",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-shader-loader": "^2.0.2",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  }
}
