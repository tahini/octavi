{
    "engines": {
        "node": ">=24.0.0"
    },
    "name": "octavi-legacy",
    "version": "0.5.0",
    "description": "Octavi legacy package, in javascript, for both backend and frontend",
    "repository": "github.com/chairemobilite/octavi",
    "license": "MIT",
    "scripts": {
        "clean": "rimraf lib/",
        "cleanModules": "rimraf node_modules/",
        "copy-files": "copyfiles -u 1 src/config/*.json lib/ ",
        "compile": "yarn copy-files && yarn babel src --out-dir=lib",
        "compile:dev": "yarn babel src --out-dir=lib --watch",
        "test": "echo 'cross-env NODE_ENV=test jest --config=jest.config.js'",
        "test:unit": "cross-env NODE_ENV=test jest --config=jest.config.js",
        "test:sequential": "cross-env NODE_ENV=test jest --config=jest.sequential.config.js --runInBand",
        "test:ui": "echo 'no tests to run for this workspace'",
        "lint": "eslint .",
        "format": "prettier-eslint \"./src/**/*.{ts,tsx}\" --write",
        "format:all": "yarn format"
    },
    "dependencies": {
        "@fortawesome/free-solid-svg-icons": "^7.1.0",
        "@fortawesome/react-fontawesome": "^3.1.1",
        "@inquirer/prompts": "^7.8.6",
        "@turf/turf": "^7.3.5",
        "chaire-lib-backend": "^0.2.2",
        "chaire-lib-common": "^0.2.2",
        "chaire-lib-frontend": "^0.2.2",
        "date-holidays": "^3.36.1",
        "fetch-retry": "^6.0.0",
        "geobuf": "^3.0.2",
        "geokdbush": "^1.1.0",
        "highcharts": "^8.2.0",
        "highcharts-react-official": "^3.2.1",
        "i18next": "^26.0.6",
        "kdbush": "^3.0.0",
        "knex-postgis": "^0.14.3",
        "lodash": "^4.18.1",
        "moment": "^2.30.1",
        "moment-timezone": "^0.5.46",
        "p-queue": "^6.6.2",
        "pbf": "^3.3.0",
        "prop-types": "^15.8.1",
        "react": "^19.2.3",
        "react-collapsible": "^2.10.0",
        "react-i18next": "^16.5.0",
        "react-map-gl": "^8.1.0",
        "react-switch": "^7.1.0",
        "stream-chain": "^3.4.0",
        "stream-json": "^1.9.1",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "@babel/cli": "^7.10.5",
        "@babel/core": "^7.10.5",
        "@babel/helper-compilation-targets": "^7.10.4",
        "@babel/node": "^7.10.5",
        "@babel/plugin-proposal-class-properties": "^7.10.4",
        "@babel/plugin-proposal-object-rest-spread": "^7.10.4",
        "@babel/plugin-syntax-dynamic-import": "^7.8.3",
        "@babel/plugin-syntax-jsx": "^7.12.1",
        "@babel/plugin-syntax-object-rest-spread": "^7.8.3",
        "@babel/plugin-transform-computed-properties": "^7.10.4",
        "@babel/plugin-transform-react-jsx": "^7.12.7",
        "@babel/plugin-transform-runtime": "^7.10.5",
        "@babel/plugin-transform-spread": "^7.10.4",
        "@babel/preset-env": "^7.10.4",
        "@babel/preset-react": "^7.10.4",
        "@babel/preset-typescript": "^7.12.1",
        "@babel/register": "^7.10.5",
        "@babel/runtime": "^7.10.5",
        "babel-jest": "^26.1.0",
        "babel-plugin-emotion": "10.0.33",
        "copyfiles": "^2.4.1",
        "cross-env": "^10.1.0",
        "dotenv": "^17.2.3",
        "jest": "^30.2.0",
        "json-loader": "^0.5.7",
        "rimraf": "^6.1.2"
    }
}
